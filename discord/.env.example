# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=replace-with-bot-token
# Right-click #play in Discord (developer mode on) -> Copy Channel ID
PLAY_CHANNEL_ID=replace-with-channel-id
# Optional: raises GitHub's rate limit from 60/h per IP to 5000/h
GITHUB_TOKEN=
# Optional: fallback when GitHub fails
GIST_PROXY_URL=https://ded.increpare.com/cgi-bin/gist_proxy.py
